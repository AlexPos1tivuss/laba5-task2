modules = ["nodejs-18"]
run = "npm run start"

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "npm run start"]

[workflows]
runButton = "Run"

[[workflows.workflow]]
name = "Run"
author = 34752070
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm start"
